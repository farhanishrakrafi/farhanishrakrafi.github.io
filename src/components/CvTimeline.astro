---
import { formatRange } from '../lib/dates.ts';
import { italicize } from '../lib/italics.ts';

interface Item {
  title: string;
  org?: string | undefined;
  location?: string | undefined;
  start?: string | undefined;
  end?: string | undefined;
  details?: string | undefined;
  bullets: string[];
  showOnSite: boolean;
}

interface Props {
  items: Item[];
}

const items = Astro.props.items.filter((i) => i.showOnSite);
---

<ol class="flex flex-col gap-5">
  {
    items.map((item) => {
      const when = formatRange(item.start, item.end);
      return (
        <li class="grid gap-1 md:grid-cols-[11rem_1fr] md:gap-6">
          <p class="text-muted text-sm md:pt-0.5">{when}</p>
          <div>
            <h3 class="font-sans text-base font-semibold" set:html={italicize(item.title)} />
            {(item.org || item.location) && (
              <p class="text-muted">{[item.org, item.location].filter(Boolean).join(', ')}</p>
            )}
            {item.details && <p set:html={italicize(item.details)} />}
            {item.bullets.length > 0 && (
              <ul class="mt-1 list-disc pl-5">
                {item.bullets.map((b) => (
                  <li set:html={italicize(b)} />
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
