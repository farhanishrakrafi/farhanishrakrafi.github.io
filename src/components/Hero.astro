---
import type { HeroPhoto } from '../lib/photo.ts';
import { getProfile } from '../lib/content.ts';
import { url } from '../lib/paths.ts';
interface Props { photo?: HeroPhoto; }
const { photo } = Astro.props;
const profile = await getProfile();
---
<section class="portfolio-hero" aria-labelledby="hero-name">
  <div class="hero-copy">
    <p class="eyebrow hero-intro">Farhan Ishrak Rafi <span aria-hidden="true">/</span> Dhaka, Bangladesh</p>
    <h1 id="hero-name">Exploring biology.<br /><em>Evaluating<br class="desktop-break" /> intelligence.</em></h1>
    <p class="hero-description">I'm a biochemist working across the bench, the genome, and scientific AI evaluation. I bring the same critical eye to biological questions and the systems that reason about them.</p>
    <div class="hero-actions">
      <a class="action-primary" href={url('/research/')}>Explore my research <span aria-hidden="true">↗</span></a>
      <a class="action-secondary" href={url('/ai-evaluation/')}>AI evaluation <span aria-hidden="true">↗</span></a>
    </div>
    <a class="availability-link" href={url('/contact/')}><span class="availability-dot" aria-hidden="true"></span>Open to roles &amp; collaborations <span aria-hidden="true">→</span></a>
  </div>
  <figure class="hero-portrait">
    <div class="portrait-topline"><span>Science in practice</span><span aria-hidden="true">01 / FIELDWORK</span></div>
    {photo ? (
      <picture>
        <source type="image/avif" srcset={photo.avifSrcset} />
        <source type="image/webp" srcset={photo.webpSrcset} />
        <img src={photo.fallback} alt={profile.photoAlt} width="560" height="560" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    ) : <div class="portrait-monogram" aria-label={profile.name}>FIR</div>}
    <figcaption><span>At the bench, with a computational perspective.</span><span aria-hidden="true">↗</span></figcaption>
  </figure>
</section>
