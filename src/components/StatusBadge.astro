---
import { STATUS_LABELS, type ProjectStatus } from '../lib/content.ts';

interface Props {
  status: ProjectStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<span class:list={['badge', `badge-${status}`, className]}>
  <span class="sr-only">Status: </span>{STATUS_LABELS[status]}
</span>
