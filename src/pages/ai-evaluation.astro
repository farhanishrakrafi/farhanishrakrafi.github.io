---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/paths.ts';

const capabilities = [
  {
    number: '01',
    title: 'Biology benchmarking',
    description: 'Expert-level tasks grounded in biological reasoning, with verifiable answers and clear evidence. I author benchmarks and peer-review tasks for scientific accuracy, ambiguity and robustness.',
    details: ['Scientific task authoring', 'Answer verification', 'Expert peer review'],
  },
  {
    number: '02',
    title: 'Model and tool-use evaluation',
    description: 'Side-by-side response evaluation, multi-turn reasoning review and scoring rubrics for tool selection. My work includes tasks that connect image investigation with web research.',
    details: ['Rubric design and calibration', 'Agentic task evaluation', 'Multimodal reasoning'],
  },
  {
    number: '03',
    title: 'Multilingual data quality',
    description: 'Bengali reasoning tasks, document OCR, multilingual transcription and voice-agent evaluation. I also annotate images and review recorded professional workflows against quality criteria.',
    details: ['Bengali language expertise', 'Voice and transcript review', 'Image annotation'],
  },
];

const experience = [
  {
    organisation: 'Poindexter Labs',
    role: 'Biology Expert and Benchmark Author',
    period: 'October 2025 to present',
    description: 'Author machine-verifiable biology tasks, including multimodal items. Review other authors’ work and compare model responses against multidimensional rubrics.',
  },
  {
    organisation: 'Mercor',
    role: 'AI Trainer and Task Writer',
    period: '',
    description: 'Evaluate multilingual voice interactions, tool calling and multi-turn reasoning. Write image-investigation tasks with reference answers and human research trajectories.',
  },
  {
    organisation: 'Outlier (Scale AI)',
    role: 'AI Trainer',
    period: 'May 2024 to July 2026',
    description: 'Write and evaluate prompts and responses for accuracy, reasoning and instruction following. Develop Bengali cultural reasoning tasks that require multiple steps of inference.',
  },
  {
    organisation: 'CNTXT AI',
    role: 'Data Annotator',
    period: 'April to May 2026',
    description: 'Annotate images with bounding boxes, polygons and keypoints for object detection, segmentation and pose estimation.',
  },
];
---

<BaseLayout
  title="AI evaluation"
  description="Farhan Ishrak Rafi’s work in biology benchmarks, model and tool-use evaluation, scoring rubrics, and multilingual AI data quality."
  ogKey="ai-evaluation"
  crumbs={[{ name: 'AI evaluation', path: '/ai-evaluation/' }]}
>
  <div class="container-site editorial-page ai-page">
    <header class="ai-intro">
      <p class="eyebrow">Scientific expertise · AI evaluation</p>
      <h1>Scientific judgment<br />for more reliable AI.</h1>
      <div class="intro-bottom">
        <p class="intro-copy">
          I bring a biochemist’s attention to evidence to AI evaluation. Alongside
          my research, I write expert tasks, design scoring rubrics and assess
          how models reason across science, language and tools.
        </p>
        <div class="work-context">
          <span class="section-label">The work</span>
          <p><span>Expert evaluation</span><span>Freelance, remote</span><span>Based in Dhaka, Bangladesh</span></p>
        </div>
      </div>
    </header>

    <section aria-labelledby="capabilities-title" class="ai-section">
      <div class="section-heading">
        <p class="section-label">01 / Capabilities</p>
        <h2 id="capabilities-title">From subject expertise<br />to careful evaluation.</h2>
      </div>
      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability">
            <span class="capability-number" aria-hidden="true">{capability.number}</span>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <ul aria-label={`${capability.title} skills`}>
              {capability.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="experience-title" class="ai-section experience-section">
      <div class="section-heading">
        <p class="section-label">02 / Selected experience</p>
        <h2 id="experience-title">Work across the<br />AI development cycle.</h2>
      </div>
      <ol class="experience-list">
        {experience.map((item) => (
          <li class="experience-row">
            <div class="experience-org">
              <h3>{item.organisation}</h3>
              {item.period && <p class="period">{item.period}</p>}
            </div>
            <div class="experience-detail">
              <p class="role">{item.role}</p>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="additional-experience">
        Additional experience includes STEM subject-matter work with SME Careers
        and AI community contributions with TELUS Digital.
      </p>
    </section>

    <section aria-labelledby="perspective-title" class="perspective">
      <div>
        <p class="section-label">03 / Perspective</p>
        <h2 id="perspective-title">The same attention<br />to evidence.</h2>
      </div>
      <div class="perspective-copy">
        <p>
          My scientific work spans microbiology, genomics and computational drug
          discovery. That background informs how I assess biological accuracy,
          distinguish a supported conclusion from an assumption, and identify
          ambiguity in a task or response.
        </p>
        <p>
          I work across Bengali, English and Hindi, with experience in both
          scientific evaluation and the language and annotation work that
          supports it.
        </p>
        <a class="text-link" href={url('/research/')}>
          Explore my research <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </section>

    <section aria-labelledby="ai-contact-title" class="ai-contact">
      <p class="section-label">Let’s work together</p>
      <h2 id="ai-contact-title">Need scientific expertise<br />on an AI evaluation team?</h2>
      <a class="contact-link" href={url('/contact/')}>
        Start a conversation <Icon name="arrow-right" size={22} />
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .ai-page { padding-top: clamp(3rem, 7vw, 6rem); padding-bottom: 1rem; }
  .ai-intro { padding-bottom: clamp(3rem, 7vw, 6rem); }
  .ai-intro h1 { margin-top: 1.1rem; font-size: clamp(2.8rem, 6.2vw, 5rem); line-height: 1.08; letter-spacing: -0.045em; }
  .intro-bottom { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); align-items: start; gap: 5rem; margin-top: 2.5rem; }
  .intro-copy { max-width: 43rem; font-size: clamp(1.1rem, 2vw, 1.25rem); line-height: 1.7; color: var(--muted); }
  .work-context { border-left: 1px solid var(--border); padding-left: 2rem; }
  .work-context p { margin-top: 0.75rem; font-size: 0.88rem; line-height: 1.9; color: var(--muted); }
  .work-context p span { display: block; }
  .ai-section { padding-block: clamp(2.5rem, 6vw, 5rem); border-top: 1px solid var(--border); }
  .section-heading { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; margin-bottom: 2.8rem; }
  .section-heading h2, .perspective h2, .ai-contact h2 { font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1.18; letter-spacing: -0.03em; }
  .section-label { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; color: var(--primary); }
  .capability-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .capability { padding-top: 1.3rem; border-top: 1px solid var(--border); }
  .capability-number { display: block; color: var(--primary); font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 1.4rem; }
  .capability h3 { font-size: 1.5rem; line-height: 1.2; margin-bottom: 1rem; }
  .capability > p { color: var(--muted); font-size: 0.94rem; line-height: 1.75; }
  .capability ul { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.55rem; font-size: 0.78rem; color: var(--text); }
  .capability li { display: flex; align-items: baseline; gap: 0.55rem; }
  .capability li::before { content: '+'; color: var(--primary); font-family: var(--font-mono); }
  .experience-list { list-style: none; margin: 0; padding: 0; }
  .experience-row { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; padding-block: 1.8rem; border-top: 1px solid var(--border); }
  .experience-org h3 { font-family: var(--font-sans); font-size: 1rem; line-height: 1.4; }
  .period { color: var(--muted); font-size: 0.78rem; margin-top: 0.45rem; }
  .role { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .experience-detail > p:last-child { color: var(--muted); max-width: 42rem; font-size: 0.94rem; line-height: 1.75; }
  .additional-experience { border-top: 1px solid var(--border); padding-top: 1.5rem; color: var(--muted); font-size: 0.83rem; max-width: 47rem; }
  .perspective { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; padding: clamp(1.5rem, 4vw, 3rem); background: var(--surface); border: 1px solid var(--border); }
  .perspective h2 { margin-top: 1.1rem; }
  .perspective-copy { color: var(--muted); font-size: 0.96rem; line-height: 1.8; }
  .perspective-copy p + p { margin-top: 1rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.65rem; min-height: 44px; margin-top: 1.1rem; font-weight: 600; text-decoration: none; color: var(--primary); }
  .text-link:hover { text-decoration: underline; }
  .ai-contact { padding-block: clamp(3rem, 7vw, 6rem) 1rem; }
  .ai-contact h2 { margin-top: 1rem; }
  .contact-link { display: inline-flex; align-items: center; gap: 2rem; margin-top: 1.8rem; padding-block: 0.7rem; border-bottom: 1px solid var(--primary); font-weight: 600; font-size: 1rem; text-decoration: none; }
  .contact-link:hover { gap: 2.5rem; }
  .contact-link { transition: gap 160ms ease; }
  @media (max-width: 760px) {
    .intro-bottom, .section-heading, .perspective { grid-template-columns: 1fr; gap: 1.5rem; }
    .work-context { border-left: 0; border-top: 1px solid var(--border); padding: 1.2rem 0 0; }
    .capability-grid { grid-template-columns: 1fr; gap: 2rem; }
    .capability h3 { font-size: 1.65rem; }
    .capability-number { margin-bottom: 0.8rem; }
    .experience-row { grid-template-columns: 1fr; gap: 0.9rem; }
    .section-heading { margin-bottom: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-link { transition: none; } }
</style>
