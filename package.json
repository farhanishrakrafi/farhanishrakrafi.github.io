{
  "name": "farhan-ishrak-rafi-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Academic profile site of Farhan Ishrak Rafi. Static Astro build for GitHub Pages.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "enrich": "tsx scripts/enrich-publications.ts",
    "cv:tex": "tsx scripts/build-cv-tex.ts",
    "cv:pdf": "tsx scripts/build-cv-tex.ts --pdf",
    "build": "npm run enrich && astro build && pagefind --site dist",
    "build:site": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "tsx scripts/check-privacy.ts && tsx scripts/check-emdash.ts && tsx scripts/check-pdf-size.ts",
    "test": "playwright test",
    "prepare": "git config core.hooksPath .githooks || true",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "3dmol": "^2.5.5",
    "astro": "^7.4.4",
    "exif-reader": "^2.0.3",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit-parents": "^6.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "simple-icons": "^16.36.0",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "katex": "$katex",
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
