{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4322 --ignore-lock",
      "startServerReadyPattern": "4322",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/research/",
        "http://localhost:4322/research/mdr-ecoli-st361-genomics/",
        "http://localhost:4322/publications/",
        "http://localhost:4322/publications/islam-2025-scirep-buche/",
        "http://localhost:4322/cv/",
        "http://localhost:4322/contact/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --no-proxy-server"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "total-byte-weight": ["error", { "maxNumericValue": 512000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
